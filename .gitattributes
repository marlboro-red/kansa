# Normalize line endings: LF in the repo and in every working tree (Windows included), so
# tools that rewrite files (tauri CLI touches src-tauri/Cargo.toml) don't produce phantom diffs.
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.png binary
*.ico binary
*.icns binary
